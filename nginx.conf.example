## Nginx config for Nirmal Connect — CloudPanel VPS
## Domain : www.ctrnirmalconnect.com
## App port: 5005 (Node.js / PM2)
##
## In CloudPanel:
##   1. Create a new site → type: Node.js
##   2. Domain: www.ctrnirmalconnect.com
##   3. Node.js port: 5005
##   CloudPanel auto-generates the reverse proxy; add the
##   extra tuning blocks below via "Vhost" editor in CloudPanel.
##
## ── CloudPanel Vhost additions (paste inside the server {} block) ─────────

server {
    listen 80;
    server_name ctrnirmalconnect.com www.ctrnirmalconnect.com;

    # Redirect HTTP → HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name ctrnirmalconnect.com www.ctrnirmalconnect.com;

    ssl_certificate     /etc/letsencrypt/live/www.ctrnirmalconnect.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/www.ctrnirmalconnect.com/privkey.pem;

    # Gzip compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;

    # Max upload size (for voter roll PDFs, gallery images, etc.)
    client_max_body_size 50M;

    # ── Proxy everything to the Node.js app on port 5005 ──────────────────
    # Express serves BOTH the API (/api/*) AND the React frontend (all other
    # routes) from a single process — no separate static-file location needed.
    location / {
        proxy_pass         http://127.0.0.1:5005;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        'upgrade';
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 120s;
    }
}
